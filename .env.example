# -----------------------------------------------------------------------------
# Drishta: Proactive AI Student Mentor Configuration
# Copy this file to '.env' and fill in your values.
# -----------------------------------------------------------------------------

# 1. LLM Configurations (OpenAI Compatible)
# Nvidia NIM API (Primary LLM)
NVIDIA_API_KEY="your-nvidia-api-key-here"
NVIDIA_LLM_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Groq API (Fallback LLM)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_LLM_MODEL="llama-3.1-70b-versatile"

# 2. Database & Storage Config
# Path to SQLite database file. If left empty, backend falls back to :memory: DB.
POLARIS_PERSIST_PATH="store.db"

# 3. Security & Authentication
# API Key required to authenticate all client requests via X-API-Key header.
# CHANGE THIS before deploying anywhere reachable from outside your machine --
# in production (APP_ENV=production) the server refuses to start if this is
# left unset or at its default value.
DRISHTA_API_KEY="drishta_secret_key"

# Secret used to sign /auth/login session tokens (HMAC). Optional: falls back
# to DRISHTA_API_KEY if unset. Set a separate value if you want to rotate the
# two independently.
DRISHTA_TOKEN_SECRET=""

# How long a login token stays valid, in seconds. Default: 24h.
DRISHTA_TOKEN_TTL_SECONDS="86400"

# Built-in demo accounts (alex.mercer@university.edu / password123, etc. --
# see backend/auth.py) usable against POST /auth/login. Set to "false" before
# going live, or provide your own DRISHTA_AUTH_USERS below.
DRISHTA_ALLOW_DEMO_USERS="true"

# Optional: JSON array of real accounts for /auth/login, e.g.
# '[{"email":"prof@school.edu","password":"changeme","role":"faculty","student_id":null,"name":"Prof"}]'
# Replace this with a real identity provider before production use.
DRISHTA_AUTH_USERS=""

# 4. CORS Allowed Origins (Comma-separated)
# Restricts which frontend domains can call the API. Required in production
# (the server refuses to start with APP_ENV=production and this unset).
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# 5. Environment & Demo Flags
# "development" (default) or "production". Production mode hides /docs,
# /redoc and /openapi.json, defaults demo endpoints OFF, and refuses to boot
# with insecure defaults (see backend/main.py:_run_production_safety_checks).
APP_ENV="development"

# Set to 'false' to fully disable the public /demo/* reset/test routes.
# Defaults to "true" in development and "false" in production if unset.
ALLOW_DEMO_ENDPOINTS="true"

# Set to "true" only if the app is deployed behind a trusted reverse proxy /
# load balancer that sets X-Forwarded-For -- otherwise rate limiting can be
# bypassed by clients spoofing that header themselves.
DRISHTA_TRUST_PROXY="false"
